# Kafka
KAFKA_PORT=
KAFKA_CFG_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093,EXTERNAL://:9094
KAFKA_CFG_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,EXTERNAL://localhost:9094
KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT,PLAINTEXT:PLAINTEXT

# Postgres
POSTGRES_DB=e2e
POSTGRES_USER=e2e
POSTGRES_PASSWORD=e2e
POSTGRES_PORT=15432

# Redis
REDIS_PORT=

# Nginx
NGINX_PORT=8100
NGINX_BACKEND_HOST=http://backend:3005
NGINX_WEBSOCKET_HOST=http://websocket:3007

# Backend
BACKEND_PORT=3100
BACKEND_BACKDOOR_TOKEN=test-backdoor-token

# App
FRONTEND_PORT=6100